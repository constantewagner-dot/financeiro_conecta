generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Responsavel {
  id        String   @id @default(uuid())
  nome      String
  email     String?  @unique
  telefone  String?
  cpf       String?  @unique
  endereco  String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  alunos Aluno[]

  @@map("responsaveis")
}

model Aluno {
  id             String    @id @default(uuid())
  nome           String
  dataNascimento DateTime? @map("data_nascimento")
  matricula      String    @unique
  email          String?
  telefone       String?
  ativo          Boolean   @default(true)
  responsavelId  String?   @map("responsavel_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  responsavel Responsavel? @relation(fields: [responsavelId], references: [id])
  matriculas  Matricula[]

  @@map("alunos")
}

model Professor {
  id        String   @id @default(uuid())
  nome      String
  email     String?  @unique
  telefone  String?
  cpf       String?  @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  turmas Turma[]

  @@map("professores")
}

model Turma {
  id          String   @id @default(uuid())
  nome        String
  anoLetivo   Int      @map("ano_letivo")
  capacidade  Int?
  professorId String?  @map("professor_id")
  ativa       Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  professor  Professor?  @relation(fields: [professorId], references: [id])
  matriculas Matricula[]

  @@map("turmas")
}

model Matricula {
  id            String   @id @default(uuid())
  alunoId       String   @map("aluno_id")
  turmaId       String   @map("turma_id")
  dataMatricula DateTime @default(now()) @map("data_matricula")
  status        String   @default("ATIVA")
  createdAt     DateTime @default(now()) @map("created_at")

  aluno Aluno @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma Turma @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaId])
  @@map("matriculas")
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  tipo      String
  descricao String?
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  contasReceber ContaReceber[]
  contasPagar   ContaPagar[]

  @@map("categorias")
}

model ContaReceber {
  id             String   @id @default(uuid())
  descricao      String
  valor          Decimal  @db.Decimal(10, 2)
  dataVencimento DateTime @map("data_vencimento")
  dataPagamento  DateTime? @map("data_pagamento")
  status         String   @default("PENDENTE")
  categoriaId    String?  @map("categoria_id")
  alunoId        String?  @map("aluno_id")
  createdAt      DateTime @default(now()) @map("created_at")

  categoria Categoria? @relation(fields: [categoriaId], references: [id])

  @@map("contas_receber")
}

model ContaPagar {
  id             String   @id @default(uuid())
  descricao      String
  valor          Decimal  @db.Decimal(10, 2)
  dataVencimento DateTime @map("data_vencimento")
  dataPagamento  DateTime? @map("data_pagamento")
  status         String   @default("PENDENTE")
  categoriaId    String?  @map("categoria_id")
  createdAt      DateTime @default(now()) @map("created_at")

  categoria Categoria? @relation(fields: [categoriaId], references: [id])

  @@map("contas_pagar")
}
